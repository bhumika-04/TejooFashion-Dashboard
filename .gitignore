## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Configuration files with secrets (never commit real keys)
appsettings.Production.json
appsettings.Development.json
backend/appsettings.json
*.config

# Commit only the placeholder template
!backend/appsettings.example.json

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# User-specific files
*.rsuser

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS Code
.vscode/

# Node modules (if frontend is added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs/
*.log

# Environment files
.env
.env.local
.env.production

# Database backups
*.bak
*.mdf
*.ldf

# Publish
publish/
*.pubxml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Runtime-generated customer media (do NOT commit — contains customer PII)
backend/wwwroot/media/
backend/wwwroot/uploads/

# Others
*.cache
*.suo
*.user
*.userosscache
*.sln.docstates
